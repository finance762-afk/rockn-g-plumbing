# ============================================================
# .htaccess
# ============================================================

Options -Indexes
DirectoryIndex index.php index.html

# Security Headers
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
</IfModule>

# Compression — Brotli first (mod_brotli), gzip fallback (v6.3)
<IfModule mod_brotli.c>
    AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/css text/javascript
    AddOutputFilterByType BROTLI_COMPRESS application/javascript application/x-javascript
    AddOutputFilterByType BROTLI_COMPRESS application/json application/xml application/ld+json
    AddOutputFilterByType BROTLI_COMPRESS image/svg+xml
</IfModule>
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript
    AddOutputFilterByType DEFLATE application/javascript application/x-javascript
    AddOutputFilterByType DEFLATE application/json application/xml application/ld+json
    AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>
<IfModule mod_mime.c>
    AddType image/avif .avif
    AddType font/woff2 .woff2
</IfModule>

# Browser Caching
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpg "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/avif "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType text/html "access plus 0 seconds"
</IfModule>
# v6.3: static assets are immutable for a year (css/js carry ?v=$cssVersion); HTML revalidates every visit
<IfModule mod_headers.c>
    <FilesMatch "\.(css|js|woff2|woff|webp|avif|jpe?g|png|gif|svg|ico)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    <FilesMatch "\.(php|html)$">
        Header set Cache-Control "no-cache, must-revalidate"
    </FilesMatch>
</IfModule>

# Clean URLs
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Dynamic sitemap — /sitemap.xml is served by sitemap.php
    RewriteRule ^sitemap\.xml$ /sitemap.php [L]

    # 301s from the old site's URLs (SEO brief, Oct 18 2026) — one hop to the final URL
    RewriteRule ^water-heaters-and-filtration-systems/?$ /services/water-heaters/ [R=301,L]
    RewriteRule ^drain-and-sewer-solutions/?$ /services/drain-cleaning/ [R=301,L]
    RewriteRule ^irrigation-services/?$ /services/irrigation-sprinkler-repair/ [R=301,L]
    RewriteRule ^new-construction-and-remodel-plumbing/?$ /services/new-construction-remodel-plumbing/ [R=301,L]
    # the brief's root-level service slugs now live under /services/
    RewriteRule ^(water-heaters|water-filtration-softeners|drain-cleaning|sewer-line-repair|leak-detection-repair|gas-line-services|irrigation-sprinkler-repair|new-construction-remodel-plumbing)/?$ /services/$1/ [R=301,L]
    # old town pages -> the one Christoval page or the single areas hub (no templated town pages)
    RewriteRule ^service-area/?$ /areas-we-serve/ [R=301,L]
    RewriteRule ^service-area/(?!christoval-tx/?$).+$ /areas-we-serve/ [R=301,L]
    # old root-level blog posts -> /blog/ (blog migration plan §2, Oct 18 2026); /?$ covers both slash variants
    RewriteRule ^drain-cleaning-and-sewer-solutions-for-homes-in-ballinger-tx/?$ /blog/recurring-drain-clogs-san-angelo/ [R=301,L]
    RewriteRule ^drain-repair-and-gas-line-work-in-san-angelo-tx-what-to-expect-when-you-need-both/?$ /blog/drain-repair-and-gas-line-work-in-san-angelo-tx-what-to-expect-when-you-need-both/ [R=301,L]
    RewriteRule ^gas-line-services-in-san-angelo-tx-safe-installation-and-repair-solutions/?$ /blog/gas-line-services-in-san-angelo-tx-safe-installation-and-repair-solutions/ [R=301,L]
    RewriteRule ^irrigation-system-installation-and-repair-near-paint-rock-tx-properties/?$ /blog/sprinkler-repair-watering-rules-san-angelo/ [R=301,L]
    RewriteRule ^new-construction-vs-remodel-plumbing-in-san-angelo-tx-what-s-different-and-why-it-matters/?$ /blog/new-construction-vs-remodel-plumbing-in-san-angelo-tx-what-s-different-and-why-it-matters/ [R=301,L]
    RewriteRule ^pipe-repair-and-replacement-solutions-for-carlsbad-tx-homes-and-businesses/?$ /blog/slab-leaks-pipe-repair-san-angelo/ [R=301,L]
    RewriteRule ^understanding-backflow-prevention-for-miles-tx-water-systems/?$ /blog/what-is-backflow-san-angelo/ [R=301,L]
    RewriteRule ^water-heater-installation-and-repair-services-available-in-christoval-tx/?$ /blog/water-heater-installation-and-repair-services-available-in-christoval-tx/ [R=301,L]

    RewriteCond %{REQUEST_URI} !^/assets/
    RewriteCond %{REQUEST_URI} !^/includes/
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{DOCUMENT_ROOT}/$1.php -f
    RewriteRule ^([^\.]+)$ $1.php [NC,L]
    RewriteCond %{THE_REQUEST} /([^.]+)\.php [NC]
    RewriteRule ^ /%1 [NC,L,R=301]
</IfModule>

ErrorDocument 404 /404.php
